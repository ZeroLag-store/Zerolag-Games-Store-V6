rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media and branding uploads
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == "zerolag0000@gmail.com" ||
        request.auth.token.email == "osamashsgshfff@gmail.com" ||
        request.auth.uid == "gnT4haA1tdVYDpzpDzR1TUBA37c2"
      );
    }
    
    // Catalog cover uploads
    match /catalog_covers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == "zerolag0000@gmail.com" ||
        request.auth.token.email == "osamashsgshfff@gmail.com" ||
        request.auth.uid == "gnT4haA1tdVYDpzpDzR1TUBA37c2"
      );
    }
    
    // Catalog screenshots & galleries
    match /catalog_galleries/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == "zerolag0000@gmail.com" ||
        request.auth.token.email == "osamashsgshfff@gmail.com" ||
        request.auth.uid == "gnT4haA1tdVYDpzpDzR1TUBA37c2"
      );
    }
    
    // Widescreen, mobile and promo banners
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == "zerolag0000@gmail.com" ||
        request.auth.token.email == "osamashsgshfff@gmail.com" ||
        request.auth.uid == "gnT4haA1tdVYDpzpDzR1TUBA37c2"
      );
    }

    // Default catch-all
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == "zerolag0000@gmail.com" ||
        request.auth.token.email == "osamashsgshfff@gmail.com" ||
        request.auth.uid == "gnT4haA1tdVYDpzpDzR1TUBA37c2"
      );
    }
  }
}
